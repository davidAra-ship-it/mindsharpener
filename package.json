{
  "name": "mindsharpener",
  "description": "Bloquea las webs que te distraen y recupera tu foco. Código abierto, 100% local, sin registros.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidAra-ship-it/mindsharpener.git"
  },
  "homepage": "https://github.com/davidAra-ship-it/mindsharpener#readme",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node tests/core.test.mts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "wxt": "^0.21.5"
  }
}
